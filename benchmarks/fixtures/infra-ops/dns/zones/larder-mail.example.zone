; larder-mail.example — transactional mail only (no web site, no certificates).
$ORIGIN larder-mail.example.
$TTL 3600
@        IN SOA   ns1.larder.example. dns.larder.example. 2026090301 7200 3600 1209600 300
@        IN NS    ns1.larder.example.
@        IN MX    10 inbound-smtp.eu-central-1.amazonaws.com.
@        IN TXT   "v=spf1 include:amazonses.com -all"
_dmarc   IN TXT   "v=DMARC1; p=reject; rua=mailto:dmarc@larder.example"
