# syntax=docker/dockerfile:1.7
# admin: the internal back-office console (one replica, Prisma).

FROM node:22-bookworm-slim AS base
WORKDIR /app
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends openssl
ADD --checksum=sha256:93dcc18adc78c65a028a84799ecf8ad40c936fdfc5f2a57b1acda5a8117fa82c https://github.com/krallin/tini/releases/download/v0.19.0/tini-amd64 /usr/local/bin/tini
RUN chmod 0755 /usr/local/bin/tini && chown 10001:10001 /app
USER 10001

FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npx prisma generate && npm run build

FROM base AS final
COPY --from=deps --chown=10001:10001 /app/node_modules ./node_modules
COPY --from=build --chown=10001:10001 /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=build --chown=10001:10001 /app/dist ./dist
COPY --from=build --chown=10001:10001 /app/prisma ./prisma
COPY --chown=10001:10001 healthcheck.js docker-entrypoint.sh ./
HEALTHCHECK --interval=30s --start-period=20s CMD ["node", "healthcheck.js"]
ENTRYPOINT ["/usr/local/bin/tini", "--", "./docker-entrypoint.sh"]
CMD ["node", "dist/main.js"]
