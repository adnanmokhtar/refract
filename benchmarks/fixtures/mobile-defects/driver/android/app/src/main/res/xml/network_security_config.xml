<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The routing provider's tile server still answers on plain HTTP for some regions. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
