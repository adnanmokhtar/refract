<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Detects which card-terminal companion app the store installed. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:name=".MerchantApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:debuggable="true"
        android:theme="@style/Theme.Merchant">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Merchant">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="merchant.pantrygo.example" android:pathPrefix="/orders" />
            </intent-filter>
        </activity>

        <activity
            android:name=".help.HelpActivity"
            android:exported="false" />

        <service android:name=".sync.InventorySyncService" android:exported="false" />

        <receiver
            android:name=".push.TokenRefreshReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.pantrygo.merchant.action.REFRESH_TOKEN" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
