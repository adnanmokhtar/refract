# Build-time configuration for the customer app. Every EXPO_PUBLIC_* value is inlined into the JavaScript bundle.
EXPO_PUBLIC_API_URL=https://api.pantrygo.example
EXPO_PUBLIC_APPSFLYER_DEV_KEY=af-dev-key-canary-0001
# CANARY: not a real credential. This fixture value stands in for the payment provider's server-side signing secret.
EXPO_PUBLIC_PAYMENTS_SECRET=canary-not-a-real-secret-0000-pantrygo-fixture
