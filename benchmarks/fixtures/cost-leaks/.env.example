# Local development: copy to .env. Production values come from k8s/overlays/prod/config.yaml.
NODE_ENV=development
DATABASE_URL=postgres://quaywise:quaywise@localhost:5432/quaywise
REDIS_URL=redis://localhost:6379
AWS_REGION=eu-central-1
# AWS_REGION=eu-west-2   # only to restore 2025 snapshots from the retired staging account
S3_ENDPOINT=http://localhost:9000
EXPORTS_BUCKET=local-exports
IMPORTS_BUCKET=local-imports
MEDIA_BUCKET=local-media
REPORTS_BUCKET=local-reports
PUBLIC_MEDIA_BASE_URL=http://localhost:9000/local-media
LLM_GATEWAY_URL=http://localhost:4010
LLM_GATEWAY_KEY=local-dev-key
CARRIER_API_BASE_URL=https://sandbox.parcelnet.example
GEOCODER_API_URL=https://sandbox.mapgrid.example
PUBLIC_ORIGIN=http://localhost:5173
