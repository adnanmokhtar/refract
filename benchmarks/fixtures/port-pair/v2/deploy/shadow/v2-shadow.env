# Environment of the v2-api-shadow deployment that receives mirrored traffic.
NODE_ENV=production
APP_TIMEZONE=Asia/Riyadh
DATABASE_URL=postgres://shadow@v2-db-shadow.norrow.internal/norrow_shadow
REDIS_URL=redis://redis-shadow.norrow.internal:6379/0
PSP_BASE_URL=https://sandbox.psp.example
MAIL_TRANSPORT=smtp://smtp.norrow.internal:587
SMS_GATEWAY_URL=http://wiremock.shadow.svc:8080/sms
PARTNER_WEBHOOKS_ENABLED=false
