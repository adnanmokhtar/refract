{
  "name": "@tallyhook/api",
  "version": "1.5.0",
  "private": true,
  "bin": {
    "tallyhook": "dist/cli/main.js"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:worker": "node dist/worker.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node dist/db/migrate.js",
    "db:seed": "node dist/db/seed.js",
    "openapi:export": "node dist/openapi/export.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.890.0",
    "@nestjs/bullmq": "11.0.3",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-fastify": "11.1.6",
    "@nestjs/swagger": "11.2.0",
    "bullmq": "5.58.5",
    "commander": "14.0.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
