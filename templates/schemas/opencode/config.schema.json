{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/opencode/config/v1.json",
  "title": "OpenCode opencode.json",
  "description": "Validates a project-local opencode.json against the per-adapter completeness contract.",
  "type": "object",
  "additionalProperties": true,
  "required": ["instructions"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "_generator": { "type": "string" },
    "_generator_fields": {
      "type": "array",
      "items": { "type": "string" }
    },
    "provider": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "model": { "type": "string" },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "prompt"],
        "properties": {
          "description": { "type": "string", "minLength": 5 },
          "prompt": { "type": "string", "minLength": 10 }
        }
      }
    }
  }
}
