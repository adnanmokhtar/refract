{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/claude-code/settings/v1.json",
  "title": "Claude Code project settings.json",
  "description": "Schema for .claude/settings.json. Validates permissions, sandbox and hook wiring.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ask": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defaultMode": {
          "type": "string",
          "enum": [
            "ask",
            "auto",
            "plan",
            "bypassPermissions"
          ],
          "description": "`auto` and `bypassPermissions` do NOT take effect from project or local settings (Claude Code >= v2.1.257) \u2014 set them in user or managed settings, or pass --permission-mode."
        },
        "additionalDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disableBypassPermissionsMode": {
          "type": "string",
          "enum": [
            "disable"
          ]
        }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "PreToolUse": {
          "$ref": "#/$defs/hookList"
        },
        "PostToolUse": {
          "$ref": "#/$defs/hookList"
        },
        "UserPromptSubmit": {
          "$ref": "#/$defs/hookList"
        },
        "SessionStart": {
          "$ref": "#/$defs/hookList"
        },
        "SessionEnd": {
          "$ref": "#/$defs/hookList"
        },
        "Stop": {
          "$ref": "#/$defs/hookList"
        },
        "SubagentStop": {
          "$ref": "#/$defs/hookList"
        },
        "PreCompact": {
          "$ref": "#/$defs/hookList"
        },
        "Notification": {
          "$ref": "#/$defs/hookList"
        }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "model": {
      "type": "string"
    },
    "outputStyle": {
      "type": "string"
    },
    "statusLine": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string"
        },
        "command": {
          "type": "string"
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "description": "Sandboxed Bash tool. OPT-IN: `enabled` defaults to false, and Claude Code pre-allows NO network domains \u2014 so enabling without `network.allowedDomains` produces MORE prompts, not fewer.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "autoAllowBashIfSandboxed": {
          "type": "boolean"
        },
        "failIfUnavailable": {
          "type": "boolean"
        },
        "excludedCommands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowUnsandboxedCommands": {
          "type": "string",
          "enum": [
            "block",
            "allow",
            "prompt"
          ]
        },
        "allowAppleEvents": {
          "type": "boolean",
          "description": "Honored ONLY from user, managed or CLI settings; project settings are ignored for this key."
        },
        "enableWeakerNestedSandbox": {
          "type": "boolean"
        },
        "enableWeakerNetworkIsolation": {
          "type": "boolean"
        },
        "ignoreViolations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bwrapPath": {
          "type": "string"
        },
        "socatPath": {
          "type": "string"
        },
        "ripgrep": {
          "type": "string"
        },
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "disabled": {
              "type": "boolean"
            },
            "allowRead": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allowWrite": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "denyRead": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "denyWrite": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allowManagedReadPathsOnly": {
              "type": "boolean"
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strictAllowlist": {
              "type": "boolean"
            },
            "allowedDomains": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deniedDomains": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allowAllUnixSockets": {
              "type": "boolean"
            },
            "allowUnixSockets": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allowLocalBinding": {
              "type": "boolean"
            },
            "allowMachLookup": {
              "type": "boolean"
            },
            "allowManagedDomainsOnly": {
              "type": "boolean"
            },
            "httpProxyPort": {
              "type": "number"
            },
            "socksProxyPort": {
              "type": "number"
            },
            "tlsTerminate": {
              "type": "boolean"
            }
          }
        },
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "envVars": {
              "type": "array"
            },
            "files": {
              "type": "array"
            },
            "allowPlaintextInject": {
              "type": "boolean"
            },
            "awsPairs": {
              "type": "object"
            },
            "sigv4": {
              "type": "string",
              "enum": [
                "block",
                "pass",
                "fail-streaming",
                "fail-presigned"
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "hookList": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hooks"
        ],
        "properties": {
          "matcher": {
            "type": "string"
          },
          "hooks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "command"
              ],
              "properties": {
                "type": {
                  "const": "command"
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "timeout": {
                  "type": "number",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
